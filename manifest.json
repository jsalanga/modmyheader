{
  "manifest_version": 3,
  "name": "ModMyHeader",
  "version": "1.0.0",
  "description": "Override outgoing request headers on any site for testing.",
  "permissions": [
    "declarativeNetRequest",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ModMyHeader",
    "default_popup": "popup.html"
  }
}
